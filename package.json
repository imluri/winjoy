{
  "name": "winjoy",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "dev": "bun ./index.html",
    "build": "bun build ./index.html --target=browser --production --outdir=dist/renderer",
    "desktop": "bun run build && electron .",
    "package:windows": "bun scripts/package-windows.ts",
    "package:installer": "bun scripts/package-installer.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "optionalDependencies": {
    "vigemclient": "1.5.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "electron": "45.3.2",
    "typescript": "~5.9.3"
  }
}
